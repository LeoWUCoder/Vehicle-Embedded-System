%endfunction
%function ChartDataMap(block, system) void
  %createrecord ChartDataElements {\
    NumChartData   5 \
    ChartDataDefaults {\
      RecordType   "ChartData"\
      Dimensions   []\
      IsTestPoint  0\
    }\
    ChartData {\
      Name         "counter"\
      Description  "ChartLocal"\
      SFName       ""\
      Path         "counter"\
      SrcLocation  ""\
    }\
    ChartData {\
      Name         "is_active_c7_VCUHVACT"\
      Description  "StateIsActive"\
      SFName       ""\
      Path         ""\
      SrcLocation  ""\
    }\
    ChartData {\
      Name         "is_c7_VCUHVACT"\
      Description  "StateActiveChild"\
      SFName       ""\
      Path         ""\
      SrcLocation  ""\
    }\
    ChartData {\
      Name         "is_ECU_HVOFF"\
      Description  "StateActiveChild"\
      SFName       ""\
      Path         "ECU_HVOFF"\
      SrcLocation  ""\
    }\
    ChartData {\
      Name         "is_ECU_HVPower"\
      Description  "StateActiveChild"\
      SFName       ""\
      Path         "ECU_HVPower"\
      SrcLocation  ""\
    }\
  }
  %return ChartDataElements
%endfunction
